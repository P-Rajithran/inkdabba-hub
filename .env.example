# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Set on Render.com Web Service)
# ==============================================================================
PORT=5000

# MongoDB Atlas Connection String:
# Obtain from Atlas > Database > Connect > Drivers > Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inkdabba-hub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inkdabba-hub?retryWrites=true&w=majority

# Strong secret key for signing JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Set on Netlify Site Configuration)
# ==============================================================================
# Live Render backend URL (no trailing slash):
VITE_API_URL=https://your-backend-service.onrender.com
